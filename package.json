    "react",
    "samiroy",
    "styleguide"
  ],
  "author": "Samir Roy",
  "contributors": [
    {
      "name": "Samir Roy",
      "url": "https://samirroy.com"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/samir-roy/eslint-config",
  "publishConfig": {
