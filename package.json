{
  "name": "@samiroy/eslint-config",
  "version": "3.0.0",
  "description": "Samiroy's ESLint config for TypeScript and React",
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./rules": "./rules.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "rules.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samir-roy/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "config",
